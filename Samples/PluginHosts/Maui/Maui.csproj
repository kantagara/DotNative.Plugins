<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DotNativeDevelopment>false</DotNativeDevelopment>
    <TargetFrameworks Condition="'$(PluginSamplePlatform)' == ''"
      >net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(PluginSamplePlatform)' != ''"
      >$(PluginSamplePlatform)</TargetFrameworks>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>Standalone Plugin Probe</ApplicationTitle>
    <ApplicationId>com.dotnative.plugins.mauiprobe</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion
      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
      >16.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion
      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
      >30.0</SupportedOSPlatformVersion>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../../artifacts/standalone-plugins/packages</RestoreAdditionalProjectSources>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../../artifacts/standalone-plugins/consumer-packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/AutomaticPluginChecks.cs" Link="AutomaticPluginChecks.cs" />
    <PackageReference Include="DotNative.Firebase.RemoteConfig" Version="0.1.0-preview.18" Condition="'$(FirebaseTestConfig)' != ''" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="DotNative.Plugins.NativeProbe" Version="0.1.0-preview.18" />
    <PackageReference Include="DotNative.Plugins.Maui" Version="0.1.0-preview.18" />
    <PackageReference
      Include="DotNative.Plugins.Android"
      Version="0.1.0-preview.18"
      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
    />
  </ItemGroup>
  <PropertyGroup Condition="'$(FirebaseTestConfig)' != ''">
    <DefineConstants>$(DefineConstants);FIREBASE_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(FirebaseTestConfig)' != ''">
    <EmbeddedResource Include="$(FirebaseTestConfig)" LogicalName="firebase-test.json" />
  </ItemGroup>
  <PropertyGroup Condition="'$(VerifyMigratedPlugins)' == 'true'">
    <DefineConstants>$(DefineConstants);MIGRATED_PLUGINS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(VerifyMigratedPlugins)' == 'true'">
    <Compile Include="../Shared/MigratedPluginChecks.cs" Link="MigratedPluginChecks.cs" />
    <PackageReference Include="DotNative.SecureStorage" Version="0.1.0-preview.18" />
    <PackageReference Include="DotNative.Permissions" Version="0.1.0-preview.18" />
    <PackageReference Include="DotNative.Sensors" Version="0.1.0-preview.18" />
    <PackageReference Include="DotNative.FilePicker" Version="0.1.0-preview.18" />
  </ItemGroup>
  <PropertyGroup Condition="'$(VerifyFileSelection)' == 'true'">
    <DefineConstants>$(DefineConstants);MIGRATED_FILE_SELECTION</DefineConstants>
  </PropertyGroup>
</Project>
