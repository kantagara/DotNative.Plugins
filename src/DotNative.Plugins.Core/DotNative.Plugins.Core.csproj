<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net9.0</TargetFramework>
    <Version>0.1.0-preview.17</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Framework-independent native service channels and plugin sessions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DotNative.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/standalone-plugins.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>
</Project>
