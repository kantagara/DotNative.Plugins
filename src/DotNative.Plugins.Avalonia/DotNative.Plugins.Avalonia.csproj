<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'android'"
      >21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion
      Condition="'$(TargetPlatformIdentifier)' == 'ios' or '$(TargetPlatformIdentifier)' == 'maccatalyst'"
      >16.0</SupportedOSPlatformVersion>
    <Version>0.1.0-preview.18</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DotNative.Plugins.Core/DotNative.Plugins.Core.csproj" />
    <ProjectReference Include="../DotNative.Plugins.Native/DotNative.Plugins.Native.csproj" />
    <ProjectReference
      Include="../DotNative.Plugins.Android/DotNative.Plugins.Android.csproj"
      Condition="'$(TargetPlatformIdentifier)' == 'android'"
    />
    <Compile Remove="buildTransitive/**/*.cs" />
    <None Include="buildTransitive/**/*.cs" Pack="true" PackagePath="%(Identity)" />
    <None Remove="buildTransitive/**/*.targets" />
    <None Include="buildTransitive/**/*.targets" Pack="true" PackagePath="%(Identity)" />
    <PackageReference Include="Avalonia" Version="11.3.10" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/standalone-plugins.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>
</Project>
